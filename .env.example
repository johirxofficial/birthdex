# BirthDex configuration. Copy to .env and adjust if needed.
# Every value can also be exported as a normal environment variable.

# Bind address and port.
HOST=0.0.0.0
PORT=5002

# Set DEBUG=1 only for local debugging (never in production).
DEBUG=0

# Captcha sessions stay valid for this many seconds (60-3600).
CAPTCHA_TTL=600

# Maximum number of pending captcha sessions kept in memory (10-5000).
CAPTCHA_CAPACITY=200

# Portal request timeouts in seconds.
CONNECT_TIMEOUT=10
READ_TIMEOUT=30

# CORS origin for browser clients. Keep "*" for a public read-only API.
ALLOW_ORIGIN=*

# Optional public URL used in captcha links when behind a reverse proxy,
# e.g. https://birthdex.example.com
PUBLIC_BASE_URL=

# Upstream portal (only change this for testing).
PORTAL_BASE=https://everify.bdris.gov.bd
